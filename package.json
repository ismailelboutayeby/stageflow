{
  "name": "stageflow",
  "version": "1.0.0",
  "private": true,
  "description": "StageFlow — Plateforme de gestion des demandes de stage",
  "scripts": {
    "dev": "next dev",
    "services:check": "node --env-file=.env.local scripts/verify-services.mjs",
    "cli:setup": "node scripts/cli-setup.mjs",
    "cli:dry-run": "node scripts/cli-setup.mjs --dry-run",
    "cli:migrate": "node scripts/cli-setup.mjs --apply-migrations --no-vercel",
    "cli:deploy": "node scripts/cli-setup.mjs --no-supabase",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "start:static-host": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run tests/rls",
    "test:rls:env": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run tests/rls",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:query": "npx --yes supabase@latest db query --linked",
    "db:verify": "npx --yes supabase@latest db query --linked --file supabase/verify_phase2.sql",
    "db:migrations": "npx --yes supabase@latest migration list --linked",
    "check:hardening": "npx --yes supabase@latest db query --linked --file supabase/check_hardening.sql",
    "test:auth:phase3": "node --env-file=.env.local scripts/phase3-auth-tests.mjs",
    "test:auth:phase3:cleanup": "node --env-file=.env.local scripts/phase3-auth-tests.mjs -- --cleanup",
    "dev:provision-test-accounts": "node --env-file=.env.local scripts/provision-local-test-accounts.mjs",
    "test:auth-fixes": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run tests/db/auth-fixes.test.ts",
    "test:role-guard": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run tests/db/role-guard-cascade.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "15.5.29",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.1.6",
    "jsdom": "^25.0.1",
    "pg": "^8.23.1",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
