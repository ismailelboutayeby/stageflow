# ---------------------------------------------------------------------------
# StageFlow — CLI credentials (LOCAL ONLY, never committed)
# ---------------------------------------------------------------------------
# Copy to `.env.cli`, fill in the tokens, then run:  npm run cli:setup
#
# Supabase token: https://supabase.com/dashboard/account/tokens
#   -> "Generate new token" (needs project + org admin rights)
# Vercel token:   https://vercel.com/account/settings/tokens
#   -> "Create Token" (scope: your personal account or team)
# ---------------------------------------------------------------------------

SUPABASE_ACCESS_TOKEN=
VERCEL_TOKEN=

# Project ref. Leave blank to read it from .env.local / supabase/.temp.
SUPABASE_PROJECT_REF=

# Database password (set when the project was created). Needed by
# `supabase link` and `supabase db push`. Optional: without it the script
# still restores the project, configures Auth and deploys, but skips SQL.
SUPABASE_DB_PASSWORD=

# Optional: production origin. If blank, the script derives
# https://<vercel-project-name>.vercel.app and uses it for Site URL,
# redirect allow-list and NEXT_PUBLIC_SITE_URL.
VERCEL_PRODUCTION_URL=

# Optional: Vercel team slug/ID (only if the project belongs to a team).
VERCEL_SCOPE=

# ---------------------------------------------------------------------------
# Custom SMTP (OPTIONAL). Leave everything blank to keep Supabase's built-in
# mailer — that is the current choice for this project.
# ---------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_ADMIN_EMAIL=
# SMTP_SENDER_NAME=StageFlow
